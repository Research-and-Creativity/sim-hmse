{
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0"
        },
        "api/test.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        {
            "src": "/test",
            "dest": "/api/test.php"
        },
        {
            "src": "/(build|hot|storage|css|js|images|fonts|vendor)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}