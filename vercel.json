{
    "$schema": "https://vercel.sh",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0"
        },
        "api/test.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        {
            "src": "/test",
            "dest": "/api/test.php"
        },
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}