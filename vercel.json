{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "installCommand": "",
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        {
            "src": "/test",
            "dest": "/api/test.php"
        },
        {
            "src": "/(build|hot|storage|css|js|images|fonts|vendor)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}